{
  "name": "Cetus",
  "version": "3.0.0",
  "description": "Dynamic analysis workbench for WebAssembly: memory scanner, strings, watchpoints, function breakpoints, patching.",
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "js": [
        "page.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  },
  "action": {
    "default_title": "Open Cetus workspace"
  },
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools/devtools.html",
  "options_page": "app/index.html#tools",
  "icons": {
    "16": "icons/cetus16.png",
    "48": "icons/cetus48.png",
    "128": "icons/cetus128.png"
  },
  "commands": {
    "cetus-slot-1": {
      "description": "Cetus: run the script assigned to slot 1"
    },
    "cetus-slot-2": {
      "description": "Cetus: run the script assigned to slot 2"
    },
    "cetus-slot-3": {
      "description": "Cetus: run the script assigned to slot 3"
    },
    "cetus-slot-4": {
      "description": "Cetus: run the script assigned to slot 4"
    }
  }
}